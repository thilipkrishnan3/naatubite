# ============================================================================
# NaatuBite - Environment Variables Template
# Copy this file to .env and fill in your Supabase credentials:
# 1. Open Supabase Dashboard -> Project Settings -> API
# 2. Copy "Project URL" and paste into SUPABASE_URL
# 3. Copy "anon / public" or publishable key and paste into SUPABASE_ANON_KEY
# ============================================================================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here
